# =========================
# Required for normal runs
# =========================
GROQ_API_KEY=your_groq_api_key_here
SMTP_EMAIL=your_sender_email@example.com
SMTP_PASSWORD=your_smtp_app_password_here

# Recommended (used for job search + enrichment)
TAVILY_API_KEY=your_tavily_api_key_here

# =========================
# Optional backups / extras
# =========================
# Backup Groq keys for failover/rate-limit handling
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional source API keys
STARTUPJOBS_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
